cabal-version:      3.0
name:               event-sorcery
version:            0.4.0.0
synopsis:           Type-driven event sourcing over the event-sorcery engine
description:
  An idiomatic Haskell binding over the shared event-sorcery Rust engine.

homepage:           https://github.com/dataclique/event-sorcery
bug-reports:        https://github.com/dataclique/event-sorcery/issues
license:            MIT
license-file:       LICENSE
build-type:         Simple
category:           Database
extra-source-files:
  conformance/encoding-v1.vectors
  conformance/README.md

common strict
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    CApiFFI
    DeriveAnyClass
    DerivingVia
    DuplicateRecordFields
    GADTs
    LinearTypes
    MultiParamTypeClasses
    MultilineStrings
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedRecordDot
    OverloadedStrings
    RankNTypes
    StandaloneDeriving
    TypeApplications
    TypeFamilies
    TypeFamilyDependencies
    UndecidableInstances
    UndecidableSuperClasses

  ghc-options:
    -Wall -Wcompat -Werror -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists
    -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

library acquisition
  import:          strict
  hs-source-dirs:  src
  exposed-modules: Event.Sorcery.Engine.Acquisition
  build-depends:   base >=4.18 && <5

library
  import:          strict
  hs-source-dirs:  src
  exposed-modules:
    Event.Sorcery.Aggregate
    Event.Sorcery.Dispatch
    Event.Sorcery.Dispatch.TestSupport
    Event.Sorcery.Dispatch.Worker
    Event.Sorcery.Engine
    Event.Sorcery.Engine.Internal.FFI
    Event.Sorcery.Job
    Event.Sorcery.Job.Execution
    Event.Sorcery.Job.Worker
    Event.Sorcery.Snapshot
    Event.Sorcery.Store
    Event.Sorcery.Stream

  other-modules:
    Event.Sorcery.Dispatch.Internal
    Event.Sorcery.Engine.Acquisition
    Event.Sorcery.Engine.Internal
    Event.Sorcery.Job.Definition
    Event.Sorcery.Job.Worker.Definition
    Event.Sorcery.Job.Worker.Internal

  extra-libraries: event_sorcery_ffi
  build-depends:
    , async                      >=2.2    && <2.3
    , base                       >=4.18   && <5
    , bytestring                 >=0.11   && <0.13
    , cborg                      >=0.2.10 && <0.3
    , conduit                    >=1.3.6  && <1.4
    , event-sorcery:acquisition
    , linear-base                >=0.5    && <0.6
    , text                       >=2.0    && <2.2
    , transformers               >=0.6    && <0.7
    , ulid                       >=0.3    && <0.4

test-suite spec
  import:             strict
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  build-tool-depends: hspec-discover:hspec-discover
  ghc-options:        -threaded -with-rtsopts=-N
  other-modules:
    DispatchPropertySpec
    DispatchSpec
    DispatchWorkerSpec
    DomainSpec
    EngineSpec
    Event.Sorcery.Engine.AcquisitionSpec
    JobExecutionSpec
    JobSpec
    JobWorkerSpec
    StoreSpec
    WireSpec

  build-depends:
    , async                      >=2.2   && <2.3
    , base                       >=4.18  && <5
    , bytestring                 >=0.11  && <0.13
    , conduit                    >=1.3.6 && <1.4
    , event-sorcery
    , event-sorcery:acquisition
    , hspec                      >=2.11  && <2.12
    , linear-base                >=0.5   && <0.6
    , QuickCheck                 >=2.14  && <2.17
    , text                       >=2.0   && <2.2
    , transformers               >=0.6   && <0.7

benchmark event-sorcery-benchmarks
  import:         strict
  type:           exitcode-stdio-1.0
  hs-source-dirs: benchmark
  main-is:        Main.hs
  ghc-options:    -O2 -threaded -rtsopts
  build-depends:
    , base           >=4.18 && <5
    , bytestring     >=0.11 && <0.13
    , criterion      >=1.6  && <1.7
    , deepseq        >=1.4  && <1.6
    , event-sorcery
    , linear-base    >=0.5  && <0.6
    , text           >=2.0  && <2.2
