cabal-version: 3.0
name:          event-sorcery
version:       0.4.0.0
synopsis:      Type-driven event sourcing over the event-sorcery engine
description:
  An idiomatic Haskell binding over the shared event-sorcery Rust engine.

homepage:      https://github.com/dataclique/event-sorcery
bug-reports:   https://github.com/dataclique/event-sorcery/issues
license:       MIT
license-file:  LICENSE
build-type:    Simple
category:      Database

common strict
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    CApiFFI
    DeriveAnyClass
    DerivingVia
    DuplicateRecordFields
    GADTs
    LinearTypes
    MultiParamTypeClasses
    MultilineStrings
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedRecordDot
    OverloadedStrings
    RankNTypes
    StandaloneDeriving
    TypeApplications
    TypeFamilies
    TypeFamilyDependencies
    UndecidableInstances
    UndecidableSuperClasses

  ghc-options:
    -Wall -Wcompat -Werror -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists
    -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

library acquisition
  import:          strict
  hs-source-dirs:  src
  exposed-modules: EventSorcery.Engine.Acquisition
  build-depends:   base >=4.18 && <5

library
  import:          strict
  hs-source-dirs:  src
  exposed-modules:
    EventSorcery.Aggregate
    EventSorcery.Dispatch
    EventSorcery.Dispatch.TestSupport
    EventSorcery.Dispatch.Worker
    EventSorcery.Engine
    EventSorcery.Engine.Internal.FFI
    EventSorcery.Job
    EventSorcery.Job.Execution
    EventSorcery.Job.Worker
    EventSorcery.Snapshot
    EventSorcery.Store
    EventSorcery.Stream

  other-modules:
    EventSorcery.Dispatch.Internal
    EventSorcery.Engine.Acquisition
    EventSorcery.Engine.Internal
    EventSorcery.Job.Definition
    EventSorcery.Job.Worker.Definition
    EventSorcery.Job.Worker.Internal

  extra-libraries: event_sorcery_ffi
  build-depends:
    , async                      >=2.2    && <2.3
    , base                       >=4.18   && <5
    , bytestring                 >=0.11   && <0.13
    , cborg                      >=0.2.10 && <0.3
    , conduit                    >=1.3.6  && <1.4
    , event-sorcery:acquisition
    , linear-base                >=0.5    && <0.6
    , text                       >=2.0    && <2.2
    , transformers               >=0.6    && <0.7

test-suite wire-spec
  import:         strict
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        WireSpec.hs
  build-depends:
    , base           >=4.18 && <5
    , bytestring     >=0.11 && <0.13
    , event-sorcery
    , tasty          >=1.5  && <1.6
    , tasty-hunit    >=0.10 && <0.11
    , text           >=2.0  && <2.2

test-suite engine-spec
  import:         strict
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        EngineSpec.hs
  other-modules:  EventSorcery.Engine.AcquisitionSpec
  ghc-options:    -threaded -with-rtsopts=-N
  build-depends:
    , base                       >=4.18 && <5
    , bytestring                 >=0.11 && <0.13
    , event-sorcery
    , event-sorcery:acquisition
    , tasty                      >=1.5  && <1.6
    , tasty-hunit                >=0.10 && <0.11

test-suite job-spec
  import:         strict
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        JobSpec.hs
  build-depends:
    , base           >=4.18  && <5
    , bytestring     >=0.11  && <0.13
    , conduit        >=1.3.6 && <1.4
    , event-sorcery
    , linear-base    >=0.5   && <0.6
    , tasty          >=1.5   && <1.6
    , tasty-hunit    >=0.10  && <0.11
    , text           >=2.0   && <2.2
    , transformers   >=0.6   && <0.7

test-suite domain-spec
  import:         strict
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        DomainSpec.hs
  build-depends:
    , base           >=4.18 && <5
    , bytestring     >=0.11 && <0.13
    , event-sorcery

test-suite store-spec
  import:         strict
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        StoreSpec.hs
  build-depends:
    , base           >=4.18 && <5
    , bytestring     >=0.11 && <0.13
    , event-sorcery
    , text           >=2.0  && <2.2

test-suite dispatch-spec
  import:         strict
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        DispatchSpec.hs
  build-depends:
    , base           >=4.18 && <5
    , bytestring     >=0.11 && <0.13
    , event-sorcery
    , text           >=2.0  && <2.2

test-suite job-execution-spec
  import:         strict
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        JobExecutionSpec.hs
  build-depends:
    , base           >=4.18 && <5
    , bytestring     >=0.11 && <0.13
    , event-sorcery
    , text           >=2.0  && <2.2

test-suite job-worker-spec
  import:         strict
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        JobWorkerSpec.hs
  build-depends:
    , async          >=2.2  && <2.3
    , base           >=4.18 && <5
    , bytestring     >=0.11 && <0.13
    , event-sorcery
    , text           >=2.0  && <2.2

test-suite dispatch-worker-spec
  import:         strict
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        DispatchWorkerSpec.hs
  build-depends:
    , base           >=4.18 && <5
    , bytestring     >=0.11 && <0.13
    , event-sorcery
    , text           >=2.0  && <2.2
